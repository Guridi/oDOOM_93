<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="odoom.Home">
    <div style="padding: 24px; max-width: 800px;">
      <h1 style="margin: 0 0 12px 0; font-size: 2.5em;">OdooM</h1>
      <div style="opacity: 0.7; margin-bottom: 24px; font-size: 1.1em;">
        Enter at your own risk. (With permissions.)
      </div>

      <div style="display: flex; gap: 12px; flex-wrap: wrap;">
        <button class="btn btn-primary btn-lg" t-on-click="onPlay">
          PLAY DOOM
        </button>
      </div>
    </div>
  </t>
</templates>
