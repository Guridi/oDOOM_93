<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- HOME (dashboard) -->
    <record id="action_odoom_home" model="ir.actions.client">
        <field name="name">OdooM</field>
        <field name="tag">odoom.home</field>
    </record>

    <!-- PLAY (canvas) -->
    <record id="action_odoom_play" model="ir.actions.client">
        <field name="name">OdooM - Play</field>
        <field name="tag">odoom.play</field>
    </record>

    <!-- App root: visible in app switcher -->
    <menuitem id="menu_odoom_root"
              name="OdooM"
              action="action_odoom_home"
              web_icon="odoom,static/description/icon.png"
              sequence="5"/>

    <!-- Menus inside the app -->
    <menuitem id="menu_odoom_play"
              name="Play"
              parent="menu_odoom_root"
              action="action_odoom_play"
              sequence="10"/>

    <menuitem id="menu_odoom_about"
              name="About"
              parent="menu_odoom_root"
              sequence="20"/>
</odoo>
